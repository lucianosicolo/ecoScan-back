DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=ecoscan

JWT_SECRET=replace_with_a_long_random_secret

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: origin exacto del navegador del celular, si el backend se ejecuta en producción.
# En desarrollo se admiten IP privadas de la red en los puertos 4200 y 8100.
# CORS_ALLOWED_ORIGINS=http://192.168.1.50:4200
